# Copy file này thành .env.local rồi điền API key Claude (lấy ở console.anthropic.com).
# Chỉ dùng để thử trên máy. Trước khi phát hành phải chuyển key sang server.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# LM Studio trên máy tính ở nhà: tự dùng khi không chấm được bằng Claude (mất mạng, hết tiền…).
# Bật LM Studio > Developer > Start Server và bật "Serve on Local Network".
# Điền địa chỉ máy tính trong Wi-Fi nhà, ví dụ http://192.168.1.13:1234
EXPO_PUBLIC_LMSTUDIO_URL=
# Tên model (không bắt buộc). Để trống thì dùng model đang nạp trong LM Studio.
EXPO_PUBLIC_LMSTUDIO_MODEL=
