# Copy file này thành .env.local rồi điền. Hướng dẫn chi tiết: docs/supabase.md

# Supabase (công khai, được phép nằm trong app)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Claude API key: KHÔNG có tiền tố EXPO_PUBLIC_ nên không bị đóng gói vào app.
# Chỉ dùng để đặt lên Supabase: npx supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# LM Studio trên máy tính ở nhà: tự dùng khi không chấm được bằng Claude (mất mạng, hết tiền…).
# Bật LM Studio > Developer > Start Server và bật "Serve on Local Network".
# Điền địa chỉ máy tính trong Wi-Fi nhà, ví dụ http://192.168.1.13:1234
EXPO_PUBLIC_LMSTUDIO_URL=
# Tên model (không bắt buộc). Để trống thì dùng model đang nạp trong LM Studio.
EXPO_PUBLIC_LMSTUDIO_MODEL=

# Chỉ để thử tính năng gói Plus khi phát triển (bản phát hành luôn bỏ qua). 1 = bật.
EXPO_PUBLIC_DEV_PLUS=0
