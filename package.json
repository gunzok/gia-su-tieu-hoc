  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_LMSTUDIO_URL= EXPO_PUBLIC_LMSTUDIO_MODEL= EXPO_PUBLIC_DEV_PLUS= expo export --platform web --output-dir dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:preview": "node scripts/ban-build.js build preview android",
    "build:dev": "node scripts/ban-build.js build development android",
    "update:preview": "node scripts/ban-build.js update",
    "version:set": "node scripts/ban-build.js version",
    "env:eas": "node scripts/ban-build.js env",
    "build:ios-sim": "node scripts/ban-build.js build preview-simulator ios",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  }
