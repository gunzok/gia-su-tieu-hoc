{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "web-giao-dien",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@4",
        "dev",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}
