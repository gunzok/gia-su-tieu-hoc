# Header bảo mật + cache cho bản web trên Cloudflare (Workers static assets đọc file này).
# X-Robots-Tag: đang chạy thử cho người được mời nên không đưa lên kết quả tìm kiếm (bỏ dòng đó khi mở cho mọi người).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  X-Robots-Tag: noindex, nofollow

# File có mã băm trong tên: cache lâu.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html luôn lấy bản mới để nhận phiên bản deploy mới.
/index.html
  Cache-Control: no-cache
