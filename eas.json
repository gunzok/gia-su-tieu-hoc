{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "scheme": "GiasuTieuhoc"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "scheme": "GiasuTieuhoc"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "scheme": "GiasuTieuhoc"
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "scheme": "GiasuTieuhoc"
      }
    }
  }
}
