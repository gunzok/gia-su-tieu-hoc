{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "supabase/functions/cham-bai",
    "supabase/functions/hoi-co",
    "supabase/functions/doc-loi",
    "supabase/functions/xoa-tai-khoan",
    "supabase/functions/_shared/plus.ts",
    "supabase/functions/_shared/luot-ngay.ts"
  ]
}
