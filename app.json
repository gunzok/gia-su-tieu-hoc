{
  "expo": {
    "name": "Gia sư Tiểu học",
    "slug": "gia-su-tieu-hoc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giasutieuhoc",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "vn.giasutieuhoc.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7BD3BA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.giasutieuhoc.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "App cần dùng camera để bé chụp bài tập cho cô giáo AI chấm.",
          "photosPermission": "App cần xem ảnh để bé chọn ảnh bài tập đã chụp sẵn."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7BD3BA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8a540a62-bf7a-4ffe-9da1-ec3017e4edd8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a540a62-bf7a-4ffe-9da1-ec3017e4edd8"
    }
  }
}
