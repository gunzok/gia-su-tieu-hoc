{
  "expo": {
    "name": "GiaSuTieuHoc",
    "slug": "gia-su-tieu-hoc",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "giasutieuhoc",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "vn.giasutieuhoc.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Gia sư Tiểu học cần kết nối máy tính trong mạng Wi-Fi nhà để chấm bài bằng AI chạy trên máy (LM Studio)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7BD3BA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.giasutieuhoc.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Gia sư Tiểu học",
      "shortName": "Gia sư Tiểu học",
      "lang": "vi",
      "description": "Gia sư AI chấm bài tập về nhà cho bé lớp 1–5, nhận xét bằng tiếng Việt và đọc thành tiếng.",
      "themeColor": "#F9F9FF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gia sư Tiểu học cần dùng camera để bé chụp bài tập cho gia sư AI chấm.",
          "photosPermission": "Gia sư Tiểu học cần xem ảnh để bé chọn các trang bài tập đã chụp sẵn."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7BD3BA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "./plugins/ten-hien-thi.js",
        {
          "displayName": "Gia sư Tiểu học"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Gia sư Tiểu học cần dùng micro để bé nói câu hỏi cho cô thay vì gõ chữ.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Gia sư Tiểu học cần dùng micro để bé nói câu hỏi cho cô thay vì gõ chữ.",
          "speechRecognitionPermission": "Gia sư Tiểu học cần nhận giọng nói tiếng Việt để chuyển câu bé nói thành chữ trong ô hỏi cô."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Gia sư Tiểu học cần dùng camera để bé chụp bài tập cho gia sư AI chấm."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8a540a62-bf7a-4ffe-9da1-ec3017e4edd8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a540a62-bf7a-4ffe-9da1-ec3017e4edd8"
    }
  }
}
